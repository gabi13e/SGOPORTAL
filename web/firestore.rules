rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public can submit applications, only admins can read/update/delete.
    match /applications/{appId} {
      allow create: if request.resource.data.keys().hasAll(['fullName','email','studentId','scholarshipType']);
      allow read, update, delete: if request.auth != null;
    }

    // Scholars: admin only
    match /scholars/{scholarId} {
      allow read, write: if request.auth != null;
    }

    // User profile docs (mobile app scholars), readable by their own auth uid
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
