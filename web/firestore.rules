rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@sgo.local'
      );
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // User profiles. Owners read/write their own; admins read all.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid);
      allow delete: if isAdmin();
    }

    // Applications.
    //   create: open to anyone (web pre-application form is public).
    //   read:   admin OR owner (uid match).
    //   update: admin OR
    //           authenticated user self-linking an unclaimed application
    //           that matches their studentId (sets uid).
    //   delete: admin only.
    match /applications/{appId} {
      allow create: if request.resource.data.keys().hasAll(['studentId', 'fullName', 'userEmail']);

      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow update: if isAdmin()
                    || (isSignedIn() && resource.data.uid == request.auth.uid)
                    || (isSignedIn()
                        && resource.data.uid == null
                        && request.resource.data.uid == request.auth.uid
                        && resource.data.studentId == myProfile().studentId);

      allow delete: if isAdmin();
    }

    // Per-user uploaded documents (mobile app).
    match /users/{uid}/documents/{docId} {
      allow read, write: if isOwner(uid) || isAdmin();
    }
  }
}
